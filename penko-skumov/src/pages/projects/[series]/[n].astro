---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Frame from '../../../components/Frame.astro';
import Page from '../../../layouts/Page.astro';
import { baseline, inkLeft, inkRight } from '../../../lib/ink';

/* D4-Viewer-1 and -2, D4-Phone-Viewer-1. One photograph on white, at its
   natural proportions, in the space between the header line and the
   bottom row. A URL per frame, so Back closes. */

export const getStaticPaths = (async () => {
  const series = await getCollection('series');
  const frames = await getCollection('frames');

  return series.flatMap((entry) => {
    const own = frames
      .filter((f) => f.data.series === entry.data.slug)
      .sort((a, b) => a.data.order - b.data.order)
      .map((f) => f.data);

    return own.map((frame, i) => ({
      params: { series: entry.data.slug, n: String(frame.order) },
      props: {
        series: entry.data,
        frame,
        index: i,
        count: own.length,
        /* no wrap: the first has no Previous, the last no Next */
        previous: i > 0 ? own[i - 1] : null,
        next: i < own.length - 1 ? own[i + 1] : null,
      },
    }));
  });
}) satisfies GetStaticPaths;

const { series, frame, index, count, previous, next } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
const counter = `${pad(index + 1)} / ${pad(count)}`;

/* The caption names the place and the year. Where the place is unknown --
   which it is for every frame until Penko supplies them -- it falls back
   to the series, as D4-Viewer-2 does for Vertical Summer, and the series
   link is left off because the caption already says the name. */
const place = frame.place ?? series.place;
const year = frame.year ?? series.years;
const caption = place ? [place, year].filter(Boolean).join(', ') : `${series.title}, ${year}`;
const showSeriesLink = Boolean(place);

const href = (n: number) => `/projects/${series.slug}/${n}/`;
const seriesHref = `/projects/${series.slug}/`;

/* The counter's baseline sits on Close's, and the caption's on the
   controls'; the two styles differ, so the boxes do not line up. */
const counterTop = Math.ceil(22 + baseline('ui') - baseline('caption'));
const captionDrop = Math.ceil(baseline('ui') - baseline('caption'));

const ink = {
  counter: inkLeft(counter, 'caption'),
  caption: inkLeft(caption, 'caption'),
  title: inkLeft(series.title, 'caption'),
  close: inkRight('Close', 'ui'),
  next: inkRight('Next', 'ui'),
};
---

<Page title={`${series.title} ${counter}`} header={false} footer={false}>
  <div class="viewer" data-previous={previous ? href(previous.order) : undefined} data-next={next ? href(next.order) : undefined} data-close={seriesHref}>
    <p class="t-caption counter" style={`top: ${counterTop}px; left: calc(var(--margin) - ${ink.counter}px)`}>
      {counter}
    </p>

    <a class="u t-ui viewer-close" href={seriesHref} style={`right: calc(var(--margin) - ${ink.close}px); --ul-r: ${ink.close}px`}>
      Close
    </a>

    {/* click anywhere on the photograph goes to the next one */}
    <div class="stage" style={`--plate-ratio: ${+(frame.width / frame.height).toFixed(6)}`}>
      {
        next ? (
          <a class="plate" href={href(next.order)} aria-label="Next photograph">
            <Frame
              file={frame.file}
              width={frame.width}
              height={frame.height}
              alt={frame.alt ?? caption}
              span={12}
              priority={true}
            />
          </a>
        ) : (
          <div class="plate">
            <Frame
              file={frame.file}
              width={frame.width}
              height={frame.height}
              alt={frame.alt ?? caption}
              span={12}
              priority={true}
            />
          </div>
        )
      }
    </div>

    <div class:list={['bottom', 'grid', showSeriesLink && 'has-link']}>
      <p class="t-caption caption span-2 start-1" style={`margin-left: -${ink.caption}px`}>{caption}</p>

      {
        showSeriesLink && (
          <a
            class="u t-caption series-link span-4 start-3"
            href={seriesHref}
            style={`--ul-l: ${ink.title}px; margin-left: -${ink.title}px`}>
            {series.title}
          </a>
        )
      }

      <nav
        class="controls t-ui span-4 start-9"
        aria-label="Photograph"
        style={`margin-right: -${ink.next}px`}>
        {previous ? <a class="u" href={href(previous.order)} rel="prev">Previous</a> : <span class="off">Previous</span>}
        {next ? <a class="u" href={href(next.order)} rel="next">Next</a> : <span class="off">Next</span>}
      </nav>
    </div>
  </div>

  {/* the neighbours, so moving along is instant */}
  {previous && <link rel="prefetch" href={href(previous.order)} />}
  {next && <link rel="prefetch" href={href(next.order)} />}
</Page>

<style>
  /* The viewer is the window: it breaks out of the page's margins so the
     photograph can go full bleed on the phone, and nothing scrolls. */
  .viewer {
    position: relative;
    height: 100svh;
    margin-inline: calc(-1 * var(--margin));
  }

  .counter,
  .viewer-close,
  .bottom {
    position: absolute;
    white-space: nowrap;
  }

  .counter {
    left: var(--margin);
  }

  .viewer-close {
    top: 22px;
    right: var(--margin);
  }

  /* 100vw less the margins by 100svh less 144, hung from the header line
     and centred across. On the phone it goes full bleed, as the board
     draws it -- a margin there would cost a third of the picture. */
  .stage {
    position: absolute;
    top: var(--header);
    left: var(--margin);
    right: var(--margin);
    height: calc(100svh - 144px);
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  /* The widest the photograph can be and still fit the stage's height;
     Frame derives its own height from that width. Both the width and the
     centring are snapped down to whole pixels -- frames sit on integer
     pixels, and an odd remainder would otherwise leave it on a half. */
  .plate {
    --plate-w: round(down, min(100%, calc((100svh - 144px) * var(--plate-ratio))), 1px);
    display: block;
    width: var(--plate-w);
    margin-left: round(down, calc((100% - var(--plate-w)) / 2), 1px);
  }

  .bottom {
    left: var(--margin);
    right: var(--margin);
    /* the controls' line sits 34px off the foot of the window */
    bottom: 34px;
    align-items: baseline;
    row-gap: 0;
  }

  .caption,
  .series-link {
    /* share the controls' baseline; the two styles differ in box height */
    margin-bottom: 0;
  }

  .controls {
    display: flex;
    justify-content: flex-end;
    gap: var(--nav-gap);
  }

  .off {
    color: var(--grey);
  }

  @media (max-width: 767px) {
    .stage {
      left: 0;
      right: 0;
    }

    /* With a series link the phone stacks: the caption on its own line,
       the link and the controls sharing the one below. Without a link the
       caption takes the controls' line, as it does on the desktop. */
    .has-link .caption,
    .has-link .series-link {
      grid-column: 1 / -1;
    }

    .has-link .caption {
      order: 1;
    }

    .has-link .series-link {
      order: 2;
      grid-column: 1 / 3;
    }

    .caption {
      grid-column: 1 / 3;
    }

    .controls {
      grid-column: 3 / -1;
      order: 3;
    }
  }
</style>

<script>
  const viewer = document.querySelector<HTMLElement>('.viewer');
  if (viewer) {
    const go = (url: string | undefined) => {
      if (url) window.location.href = url;
    };
    const { previous, next, close } = viewer.dataset;

    document.addEventListener('keydown', (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.key === 'ArrowLeft') go(previous);
      else if (event.key === 'ArrowRight') go(next);
      else if (event.key === 'Escape') go(close);
      else return;
      event.preventDefault();
    });

    /* swipe, for the phone */
    let startX = 0;
    let startY = 0;
    viewer.addEventListener(
      'touchstart',
      (event) => {
        startX = event.changedTouches[0].clientX;
        startY = event.changedTouches[0].clientY;
      },
      { passive: true },
    );
    viewer.addEventListener(
      'touchend',
      (event) => {
        const dx = event.changedTouches[0].clientX - startX;
        const dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
        go(dx < 0 ? next : previous);
      },
      { passive: true },
    );

    /*
      The handoff asks for focus to move to Close on open, trapped, and
      returned on close. That is overlay behaviour, and this viewer is a
      page of its own: the keys above work wherever focus is, Close is
      already the first thing Tab reaches, and focusing it on load would
      ring it for every reader who arrived with a mouse. It comes back
      with step 9, when the viewer can open over the series page.
    */
  }
</script>
