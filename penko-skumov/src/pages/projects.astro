---
import { getCollection, getEntry } from 'astro:content';
import Frame from '../components/Frame.astro';
import Page from '../layouts/Page.astro';
import { boxTopForCap, inkLeft, inkRight } from '../lib/ink';

/* D4-Projects: Projects in columns 1-4, Archive in 5-8, and a slot in
   9-12 showing the opening frame of the series under the pointer, the
   first row by default. D4-Phone-Projects: the two lists in one column. */

const series = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const frames = await getCollection('frames');

const withCover = series.map((entry) => {
  const cover = entry.data.cover ? frames.find((f) => f.id === entry.data.cover) : undefined;
  return {
    ...entry.data,
    href: `/projects/${entry.data.slug}/`,
    titleInk: inkLeft(entry.data.title, 'title'),
    titleInkRight: inkRight(entry.data.title, 'title'),
    yearInk: inkLeft(entry.data.years, 'caption'),
    cover: cover?.data,
    /* the caption reads "<place>, <years>"; place is still missing */
    captionText: [entry.data.place, entry.data.years].filter(Boolean).join(', '),
  };
});

const projects = withCover.filter((s) => s.group === 'projects');
const archive = withCover.filter((s) => s.group === 'archive');

/* Section labels: a 12/16 line whose cap-top sits on 64, as every page's
   first line does. */
const labelTop = boxTopForCap('caption', 64);
const labelInk = (text: string) => inkLeft(text, 'caption');

/* The preview slot: 4 columns for a landscape frame, 2 for a portrait one
   (210px at the L tier), hung from column 9 at the same 64 the lists start
   from. */
const previewSpan = (cover?: { width: number; height: number }) =>
  cover && cover.width < cover.height ? 2 : 4;

const previewable = withCover.filter((s) => s.cover);
---

<Page title="Projects" current="projects">
  <h1 class="visually-hidden">Projects</h1>

  <div class="index grid">
    <section class="list subgrid span-4 start-1">
      <h2 class="t-caption ink-top label" style={`margin-left: -${labelInk('Projects')}px`}>Projects</h2>
      <ul class="rows">
        {
          projects.map((s) => (
            <li class="row" data-series={s.slug}>
              <span class="t-caption year" style={`margin-left: -${s.yearInk}px`}>{s.years}</span>
              {s.cover ? (
                <a
                  class="u t-title title"
                  href={s.href}
                  style={`margin-left: -${s.titleInk}px; --ul-l: ${s.titleInk}px; --ul-r: ${s.titleInkRight}px`}>
                  {s.title}
                </a>
              ) : (
                /* Film Archive is on the list but has no page and no frames
                   on the old site, so there is nothing to link to yet. */
                <span class="t-title title" style={`margin-left: -${s.titleInk}px`}>{s.title}</span>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="list subgrid span-4 start-5">
      <h2 class="t-caption ink-top label" style={`margin-left: -${labelInk('Archive')}px`}>Archive</h2>
      <ul class="rows">
        {
          archive.map((s) => (
            <li class="row" data-series={s.slug}>
              <span class="t-caption year" style={`margin-left: -${s.yearInk}px`}>{s.years}</span>
              {s.cover ? (
                <a
                  class="u t-title title"
                  href={s.href}
                  style={`margin-left: -${s.titleInk}px; --ul-l: ${s.titleInk}px; --ul-r: ${s.titleInkRight}px`}>
                  {s.title}
                </a>
              ) : (
                /* Film Archive is on the list but has no page and no frames
                   on the old site, so there is nothing to link to yet. */
                <span class="t-title title" style={`margin-left: -${s.titleInk}px`}>{s.title}</span>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    {/* One preview per series, stacked in the same slot; the pointer picks
        which is shown. They dissolve between each other over 300ms. */}
    <div class="previews span-4 start-9" aria-hidden="true">
      {
        previewable.map((s, i) => (
          <figure class="preview" data-preview={s.slug} data-first={i === 0 ? '' : undefined}>
            <div class={`plate plate-${previewSpan(s.cover)}`}>
              <Frame
                file={s.cover!.file}
                width={s.cover!.width}
                height={s.cover!.height}
                alt={null}
                span={previewSpan(s.cover)}
                spans={{ S: previewSpan(s.cover) }}
              />
            </div>
            <figcaption class="t-caption caption">
              <span class="where">{s.captionText}</span>
              <span class="what">{s.title}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</Page>

<style>
  .index {
    position: relative;
    row-gap: 0;
  }

  /* The two lists sit on the page's own columns, so the year lands in
     column 1 of the module and the title starts in column 2 -- 155px at
     the L tier, which is the 115px offset the board draws. */
  .list {
    align-content: start;
  }

  .label,
  .rows {
    grid-column: 1 / -1;
  }

  .label {
    margin-bottom: 0;
  }

  .rows {
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    row-gap: 16px;
    /* the label's line box ends at 76; the first title's box starts at 94 */
    margin-top: 18px;
  }

  /* The year comes first in the markup so that auto-placement fills
     column 1 before the title takes columns 2 to 4; a title placed first
     would push its own year onto the next row. The phone puts the title
     back on top with order. */
  .row {
    display: contents;
  }

  .year {
    grid-column: 1;
    white-space: nowrap;
  }

  .title {
    grid-column: 2 / -1;
    justify-self: start;
    white-space: nowrap;
  }

  /* --- the preview slot ------------------------------------------------ */
  .previews {
    position: relative;
  }

  .preview {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    margin: 0;
    opacity: 0;
    transition: opacity var(--dissolve-out) var(--timing);
  }

  /* a landscape cover fills the slot; a portrait one takes two of its four
     columns, which is the 210px the board draws */
  .plate-4 {
    width: 100%;
  }

  .plate-2 {
    width: calc((100% - var(--gutter)) / 2);
  }

  .caption {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: var(--caption-gap);
    white-space: nowrap;
  }

  .caption .what {
    color: var(--ink);
  }

  /* the first row shows by default, and gives way to whichever row the
     pointer is on */
  .index:not(:has(.row:hover)) .preview[data-first] {
    opacity: 1;
  }

  /* the first row of the Projects list only: it is the one whose preview
     is showing by default */
  .index:not(:has(.row:hover)) .list:first-of-type .row:first-child .title::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .preview {
      transition: none;
    }
  }

  /* The slot needs columns 9 to 12, so it exists only on the twelve-column
     tiers. Below that the two lists run one under the other, title first
     and the year under it. */
  @media (max-width: 1023px) {
    .previews {
      display: none;
    }

    .list {
      grid-column: 1 / -1;
      display: block;
    }

    .list + .list {
      margin-top: 74px;
    }

    .rows {
      display: block;
      margin-top: 18px;
    }

    .row {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 7px;
    }

    /* title over year, as D4-Phone-Projects draws it */
    .title {
      order: -1;
    }

    .year {
      margin-top: 5px;
    }
  }
</style>

<script>
  /* Show the preview for the row under the pointer. CSS alone would need a
     rule per series; this keeps the markup generated from the content. */
  const index = document.querySelector('.index');
  const previews = new Map<string, HTMLElement>();
  for (const el of document.querySelectorAll<HTMLElement>('.preview')) {
    const slug = el.dataset.preview;
    if (slug) previews.set(slug, el);
  }

  let shown: HTMLElement | undefined;

  const show = (slug: string | undefined) => {
    const next = slug ? previews.get(slug) : undefined;
    if (next === shown) return;
    if (shown) shown.style.opacity = '';
    shown = next;
    if (shown) shown.style.opacity = '1';
  };

  for (const row of document.querySelectorAll<HTMLElement>('.row')) {
    row.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'touch') return;
      show(row.dataset.series);
    });
  }

  index?.addEventListener('pointerleave', () => show(undefined));
</script>
